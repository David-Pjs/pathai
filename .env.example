# Copy this file to .env.local and fill in your keys.

# Which LLM provider to use as primary: "deepseek" or "groq".
# The app fails over to the other provider automatically if the primary flakes.
LLM_PROVIDER=deepseek

# DeepSeek API key. Required when LLM_PROVIDER=deepseek.
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Groq API key. Required for speech-to-text (Whisper) in the interview room,
# and used as the LLM when LLM_PROVIDER=groq or as the failover provider.
# Get one at https://console.groq.com
GROQ_API_KEY=gsk-your-groq-key
